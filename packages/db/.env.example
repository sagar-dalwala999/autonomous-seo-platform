# --- Postgres (Prisma) ---------------------------------------------------------
# Transaction pooler, port 6543. Runtime queries only. pgbouncer=true is REQUIRED.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30&connect_timeout=15"
# Session pooler, port 5432. prisma migrate / db push / introspection / importer ONLY.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# --- Supabase: server only (uploads / signed URLs / JWT verify) ----------------
# BYPASSES RLS. Never expose to the browser, never prefix with VITE_.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<set this — every storage/JWT path in src/storage/supabaseStorage.ts degrades to a clean 'not configured' state and lights up with zero code changes when this is present>"

# --- Retention / pruning policy -------------------------------------------------
# Keep only the N most recent crawls per site. Applied by src/retention.
RETAIN_CRAWLS_PER_SITE=10

# --- Importer ---------------------------------------------------------------
# ISO-8601 cutoff below which a run's issues.json is refused for Finding/Issue/
# healthScore import (score-era mismatch). Defaults to the mtime of
# poc/seo-crawler-poc/src/analysis/**/*.ts if unset (auto-detects "now").
SCORING_MODEL_CUTOFF_ISO=
